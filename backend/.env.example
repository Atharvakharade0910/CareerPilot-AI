DATABASE_URL=postgresql+psycopg://careerpilot:CHANGE_ME@127.0.0.1:55432/careerpilot
FRONTEND_ORIGIN=http://localhost:3010
STORAGE_DIR=./private/resumes
SECURE_COOKIES=false
ENVIRONMENT=development
# Add your private Gemini API key locally; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OCR_ENABLED=true
# Windows default; set this to the installed tesseract.exe path on the server.
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
SENTRY_DSN=
AUTH_RATE_LIMIT_PER_MINUTE=30
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
